# B8 - Deux sous-solutions independantes (recette jalon 2)
# Le maximum et le minimum sont calcules en parallele.
# attendu : { { 17 | max }, { 2 | min } }

let max = replace x, y by x if x >= y ;
let min = replace x, y by x if x <= y ;
{ { 4, 17, 9, 17, 2, 11 | max }, { 4, 17, 9, 17, 2, 11 | min } }
